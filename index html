                ],
                correctIdx: 2,
                explanation: 'Memperoleh pelayanan publik secara adil adalah hak warga masyarakat, sedangkan opsi A, B, dan D adalah kewajiban.'
            },
            {
                question: '9. Apabila sebagian besar warga di suatu wilayah hanya menuntut hak tanpa mau melaksanakan kewajibannya, dampak yang paling mungkin terjadi adalah...',
                options: [
                    'Terciptanya kerukunan dan solidaritas sosial yang tinggi',
                    'Timbulnya konflik sosial, ketidakadilan, dan terganggunya ketertiban umum',
                    'Peningkatan kualitas fasilitas umum secara otomatis',
                    'Berkurangnya tanggung jawab pemerintah dan masyarakat'
                ],
                correctIdx: 1,
                explanation: 'Pengabaian kewajiban akan merampas hak warga lainnya sehingga memicu ketidaktertiban dan konflik.'
            },
            {
                question: '10. Prinsip utama yang harus dipegang oleh seorang pelajar SMA sebagai warga negara yang baik adalah...',
                options: [
                    'Mendahulukan penuntutan hak sebelum menjalankan tugas',
                    'Menjalankan kewajiban dengan penuh tanggung jawab seiring pemenuhan hak secara proporsional',
                    'Menghindari peraturan yang dianggap membatasi kebebasan pribadi',
                    'Hanya peduli pada hak diri sendiri dan kelompoknya'
                ],
                correctIdx: 1,
                explanation: 'Warga negara yang baik senantiasa mengutamakan tanggung jawab pelaksanaan kewajiban demi kebaikan bersama.'
            }
        ];

        function selectQuizOption(optIdx) {
            const qIdx = appState.quizCurrentIdx;
            if (appState.quizAnswered[qIdx] !== undefined) return; // Kunci jawaban setelah memilih

            appState.quizAnswered[qIdx] = optIdx;
            const currentQ = quizQuestions[qIdx];
            const isCorrect = currentQ.correctIdx === optIdx;

            if (isCorrect) {
                playTone('correct');
                appState.quizScore += 10;
                addTeamPoints(appState.activeTeamIndex, 10, `(Kuis Soal #${qIdx + 1})`);
                if (typeof confetti === 'function') {
                    confetti({ particleCount: 55, spread: 60, origin: { y: 0.7 } });
                }
            } else {
                playTone('wrong');
            }

            if (Object.keys(appState.quizAnswered).length === quizQuestions.length) {
                appState.completedZones.kuis = true;
            }

            renderQuiz();
        }

        function changeQuizStep(delta) {
            const next = appState.quizCurrentIdx + delta;
            if (next >= 0 && next < quizQuestions.length) {
                playTone('click');
                appState.quizCurrentIdx = next;
                renderQuiz();
            }
        }

        function resetQuiz() {
            playTone('click');
            appState.quizCurrentIdx = 0;
            appState.quizScore = 0;
            appState.quizAnswered = {};
            renderQuiz();
        }

        function renderQuiz() {
            const qIdx = appState.quizCurrentIdx;
            const total = quizQuestions.length;
            const currentQ = quizQuestions[qIdx];
            const userAns = appState.quizAnswered[qIdx];
            const answeredCount = Object.keys(appState.quizAnswered).length;

            // Update Progress Bar & Score
            document.getElementById('quiz-progress-text').textContent = `Soal ${qIdx + 1} dari ${total}`;
            document.getElementById('quiz-score-badge').textContent = `Skor Kuis: ${appState.quizScore} / ${total * 10}`;
            document.getElementById('quiz-progress-bar').style.width = `${((qIdx + 1) / total) * 100}%`;

            const box = document.getElementById('quiz-box');

            // Jika semua soal selesai dan user menekan lihat hasil akhir
            if (qIdx === total - 1 && userAns !== undefined && answeredCount === total) {
                // Tampilkan soal terakhir beserta kartu ringkasan hasil akhir
            }

            let explanationHTML = '';
            if (userAns !== undefined) {
                const isRight = userAns === currentQ.correctIdx;
                explanationHTML = `
                    <div class="mt-6 p-5 rounded-2xl border-2 ${isRight ? 'bg-emerald-50 border-emerald-400 text-emerald-900' : 'bg-rose-50 border-rose-400 text-rose-900'}">
                        <div class="font-display font-extrabold text-lg mb-1">
                            ${isRight ? '🎉 Jawaban Benar! (+10 Poin)' : '❌ Jawaban Kurang Tepat'}
                        </div>
                        <p class="text-sm sm:text-base">${currentQ.explanation}</p>
                    </div>
                `;
            }

            const isAllFinished = answeredCount === total;

            box.innerHTML = `
                <div class="space-y-6">
                    <div class="flex items-center justify-between gap-2">
                        <span class="bg-blue-100 text-electric-500 font-bold text-xs px-3 py-1 rounded-full uppercase">Pertanyaan Analisis #${qIdx + 1}</span>
                        <span class="text-xs font-semibold text-slate-500">${answeredCount} dari ${total} soal terjawab</span>
                    </div>

                    <h3 class="font-display font-extrabold text-xl sm:text-2xl text-navy-900 leading-snug">
                        ${currentQ.question}
                    </h3>

                    <div class="grid grid-cols-1 gap-3.5">
                        ${currentQ.options.map((opt, idx) => {
                            let btnClass = 'bg-slate-50 hover:bg-blue-50 border-slate-200 hover:border-electric-400 text-slate-800';
                            if (userAns !== undefined) {
                                if (idx === currentQ.correctIdx) {
                                    btnClass = 'bg-emerald-500 border-emerald-600 text-white shadow-md';
                                } else if (idx === userAns) {
                                    btnClass = 'bg-rose-500 border-rose-600 text-white shadow-md';
                                } else {
                                    btnClass = 'bg-slate-100 border-slate-200 text-slate-400 opacity-70';
                                }
                            }

                            return `
                                <button onclick="selectQuizOption(${idx})" ${userAns !== undefined ? 'disabled' : ''} class="btn-touch w-full text-left p-4 sm:p-5 rounded-2xl border-2 font-semibold text-sm sm:text-base transition-all flex items-center gap-4 ${btnClass}">
                                    <span class="w-10 h-10 rounded-xl ${userAns !== undefined && (idx === currentQ.correctIdx || idx === userAns) ? 'bg-white/20 text-white' : 'bg-white text-navy-900 shadow-sm'} font-extrabold flex items-center justify-center shrink-0">
                                        ${String.fromCharCode(65 + idx)}
                                    </span>
                                    <span>${opt}</span>
                                </button>
                            `;
                        }).join('')}
                    </div>

                    ${explanationHTML}

                    ${isAllFinished ? `
                        <div class="bg-gradient-to-r from-navy-900 to-electric-500 text-white p-6 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg">
                            <div>
                                <div class="text-gold-400 font-bold text-xs uppercase">Arena Kuis Selesai!</div>
                                <div class="font-display font-extrabold text-xl">Total Skor Kuis: ${appState.quizScore} / ${total * 10}</div>
                            </div>
                            <div class="flex flex-wrap gap-3">
                                <button onclick="resetQuiz()" class="btn-touch bg-white/15 hover:bg-white/25 text-white font-bold px-4 py-3 rounded-xl text-sm">
                                    🔄 Coba Kuis Lagi
                                </button>
                                <button onclick="navigateTo('refleksi')" class="btn-touch bg-gold-500 hover:bg-gold-400 text-navy-900 font-extrabold px-5 py-3 rounded-xl text-sm shadow">
                                    Lanjut ke Refleksi →
                                </button>
                            </div>
                        </div>
                    ` : ''}

                    <div class="flex items-center justify-between pt-4 border-t border-slate-200">
                        <button onclick="changeQuizStep(-1)" ${qIdx === 0 ? 'disabled' : ''} class="btn-touch px-5 py-3 rounded-xl font-bold bg-slate-100 text-slate-700 disabled:opacity-40">
                            ← Soal Sebelumnya
                        </button>
                        ${qIdx < total - 1
                            ? `<button onclick="changeQuizStep(1)" class="btn-touch px-6 py-3 rounded-xl font-bold bg-electric-500 text-white shadow-sm">Soal Selanjutnya →</button>`
                            : `<button onclick="navigateTo('refleksi')" class="btn-touch px-6 py-3 rounded-xl font-bold bg-emerald-600 text-white shadow-md">Menuju Halaman Refleksi →</button>`
                        }
                    </div>
                </div>
            `;
        }

        // =================================================================
        // 10. PENYELESAIAN PETUALANGAN & PODIUM JUARA
        // =================================================================
        function finishAdventure() {
            playTone('fanfare');
            if (typeof confetti === 'function') {
                confetti({ particleCount: 120, spread: 90, origin: { y: 0.6 } });
            }
            toggleScoreboardModal();
            showToast('Selamat! Seluruh Misi Warga Negara Telah Selesai!', '🎉');
        }

        // Inisialisasi awal saat halaman dimuat
        window.addEventListener('DOMContentLoaded', () => {
            renderDashboard();
            renderMateri();
            renderMisi1();
            renderMisi2();
            renderMisi3();
            renderQuiz();
        });
    </script>
</body>
</html>
