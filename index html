                            <line x1="95" y1="85" x2="95" y2="45" stroke="#FFFFFF" stroke-width="3"/>
                            <rect x="95" y="45" width="32" height="10" fill="#EF4444"/>
                            <rect x="95" y="55" width="32" height="10" fill="#FFFFFF"/>

                            <!-- Lingkungan Masyarakat / Taman & Rumah (Kanan) -->
                            <rect x="245" y="150" width="110" height="100" rx="10" fill="#DBEAFE"/>
                            <polygon points="235,155 300,110 365,155" fill="#2563EB"/>
                            <rect x="285" y="195" width="30" height="55" rx="4" fill="#0A192F"/>
                            <!-- Pohon Hijau -->
                            <rect x="195" y="205" width="12" height="45" fill="#92400E"/>
                            <circle cx="201" cy="185" r="28" fill="#10B981"/>

                            <!-- Dua Siswa SMA Berdampingan (Seragam Putih Abu-abu) -->
                            <!-- Siswa 1 (Putra) -->
                            <circle cx="155" cy="185" r="20" fill="#FDE68A"/>
                            <path d="M135 182 Q155 160 175 182" fill="#0F172A"/>
                            <rect x="137" y="208" width="36" height="42" rx="8" fill="#FFFFFF"/>
                            <rect x="137" y="245" width="36" height="35" rx="4" fill="#64748B"/>
                            <polygon points="155,208 151,232 155,237 159,232" fill="#64748B"/>

                            <!-- Siswa 2 (Putri) -->
                            <circle cx="245" cy="188" r="19" fill="#FDE68A"/>
                            <path d="M224 190 Q245 162 266 190 L268 215 L222 215 Z" fill="#1E293B"/>
                            <rect x="227" y="210" width="36" height="40" rx="8" fill="#FFFFFF"/>
                            <rect x="227" y="245" width="36" height="35" rx="4" fill="#64748B"/>

                            <!-- Simbol Perisai Keseimbangan di Tengah -->
                            <path d="M200 100 L226 112 V135 C226 152 200 165 200 165 C200 165 174 152 174 135 V112 L200 100 Z" fill="#F59E0B" stroke="#FFFFFF" stroke-width="3"/>
                            <path d="M191 133 L198 140 L211 125" stroke="#0A192F" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs font-bold">
                            <div class="bg-navy-900/60 p-2 rounded-xl text-blue-200">🤝 Kolaboratif</div>
                            <div class="bg-navy-900/60 p-2 rounded-xl text-gold-400">🎮 Gamifikasi</div>
                            <div class="bg-navy-900/60 p-2 rounded-xl text-emerald-300">🧠 Kritis</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =================================================================
             2. DASHBOARD UTAMA (6 MENU MISI & LEADERBOARD MINI)
        ================================================================== -->
        <section id="page-dashboard" class="page-section max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
            <!-- Header Dashboard & Progres Petualangan -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                <div class="space-y-2">
                    <div class="flex items-center gap-2">
                        <span class="bg-electric-100 text-electric-500 font-bold text-xs px-3 py-1 rounded-full uppercase tracking-wider">Peta Petualangan Kelas</span>
                        <span id="progress-badge" class="bg-gold-100 text-amber-800 font-bold text-xs px-3 py-1 rounded-full">0 / 6 Zona Selesai</span>
                    </div>
                    <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-navy-900">Pilih Zona Misi Pembelajaran</h2>
                    <p class="text-slate-600 text-sm sm:text-base">Ikuti alur misi secara berurutan atau pilih zona tantangan bersama kelompokmu.</p>
                </div>

                <!-- Pemilih Kelompok Aktif untuk Layar Sentuh Mobile/Tablet -->
                <div class="w-full lg:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-3 bg-slate-100 p-3 rounded-2xl">
                    <span class="text-xs font-bold text-slate-500 uppercase px-2">Kelompok Bermain:</span>
                    <div class="grid grid-cols-2 sm:flex gap-2" id="dashboard-team-pills">
                        <!-- Diisi otomatis via JS -->
                    </div>
                </div>
            </div>

            <!-- Grid 6 Menu Utama -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Menu 1: Zona Materi -->
                <button onclick="navigateTo('materi')" class="card-hover btn-touch text-left bg-white rounded-3xl p-6 border-2 border-slate-200 hover:border-electric-500 shadow-sm flex flex-col justify-between group relative overflow-hidden">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-14 h-14 rounded-2xl bg-blue-100 text-electric-500 flex items-center justify-center text-3xl font-bold group-hover:bg-electric-500 group-hover:text-white transition-colors">
                            📘
                        </div>
                        <span id="status-materi" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600">Tahap 1</span>
                    </div>
                    <div>
                        <h3 class="font-display font-extrabold text-xl text-navy-900 mb-2">1. ZONA MATERI</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">Eksplorasi konsep hak, kewajiban, serta contoh penerapannya di lingkungan sekolah dan masyarakat.</p>
                    </div>
                    <div class="mt-6 flex items-center text-electric-500 font-bold text-sm">
                        <span>Pelajari Konsep</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                </button>

                <!-- Menu 2: Misi 1 -->
                <button onclick="navigateTo('misi1')" class="card-hover btn-touch text-left bg-white rounded-3xl p-6 border-2 border-slate-200 hover:border-electric-500 shadow-sm flex flex-col justify-between group">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-3xl font-bold group-hover:bg-gold-500 group-hover:text-navy-900 transition-colors">
                            🗂️
                        </div>
                        <span id="status-misi1" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600">Tahap 2</span>
                    </div>
                    <div>
                        <h3 class="font-display font-extrabold text-xl text-navy-900 mb-2">2. MISI 1: KENALI HAK & KEWAJIBAN</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">Permainan klasifikasi cepat: kelompokkan 8 kartu perilaku ke dalam kategori Hak atau Kewajiban.</p>
                    </div>
                    <div class="mt-6 flex items-center text-electric-500 font-bold text-sm">
                        <span>Mulai Klasifikasi</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                </button>

                <!-- Menu 3: Misi 2 -->
                <button onclick="navigateTo('misi2')" class="card-hover btn-touch text-left bg-white rounded-3xl p-6 border-2 border-slate-200 hover:border-electric-500 shadow-sm flex flex-col justify-between group">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl font-bold group-hover:bg-emerald-500 group-hover:text-white transition-colors">
                            🏫
                        </div>
                        <span id="status-misi2" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600">Tahap 3</span>
                    </div>
                    <div>
                        <h3 class="font-display font-extrabold text-xl text-navy-900 mb-2">3. MISI 2: TANTANGAN WARGA SEKOLAH</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">Simulasi pengambilan keputusan pada 4 situasi dilema nyata di lingkungan sekolah.</p>
                    </div>
                    <div class="mt-6 flex items-center text-electric-500 font-bold text-sm">
                        <span>Pecahkan Tantangan</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                </button>

                <!-- Menu 4: Misi 3 -->
                <button onclick="navigateTo('misi3')" class="card-hover btn-touch text-left bg-white rounded-3xl p-6 border-2 border-slate-200 hover:border-electric-500 shadow-sm flex flex-col justify-between group">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-14 h-14 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-3xl font-bold group-hover:bg-indigo-500 group-hover:text-white transition-colors">
                            🏘️
                        </div>
                        <span id="status-misi3" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600">Tahap 4</span>
                    </div>
                    <div>
                        <h3 class="font-display font-extrabold text-xl text-navy-900 mb-2">4. MISI 3: TANTANGAN WARGA MASYARAKAT</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">Analisis 4 kasus sosial: tentukan hak terkait, kewajiban yang dilalaikan, serta solusi terbaik.</p>
                    </div>
                    <div class="mt-6 flex items-center text-electric-500 font-bold text-sm">
                        <span>Hadapi Studi Kasus</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                </button>

                <!-- Menu 5: Misi 4 -->
                <button onclick="navigateTo('misi4')" class="card-hover btn-touch text-left bg-white rounded-3xl p-6 border-2 border-slate-200 hover:border-electric-500 shadow-sm flex flex-col justify-between group">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-3xl font-bold group-hover:bg-rose-500 group-hover:text-white transition-colors">
