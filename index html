<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MISI WARGA NEGARA - Pendidikan Pancasila Kelas X SMA</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Tone.js untuk efek suara interaktif tanpa file eksternal -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- Canvas Confetti untuk perayaan -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            900: '#0A192F',
                            800: '#112240',
                            700: '#1D3557',
                        },
                        electric: {
                            500: '#2563EB',
                            400: '#3B82F6',
                            100: '#DBEAFE',
                        },
                        gold: {
                            500: '#F59E0B',
                            400: '#FBBF24',
                            100: '#FEF3C7',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #F0F4F8;
            color: #0F172A;
            overflow-x: hidden;
            user-select: none; /* Mencegah seleksi teks tidak sengaja saat sentuh layar IFP */
        }

        /* Animasi Transisi Halaman */
        .page-section {
            display: none;
            animation: fadeSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .page-section.active {
            display: block;
        }

        @keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Efek Kartu & Tombol Sentuh Besar (IFP Friendly) */
        .btn-touch {
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .btn-touch:active {
            transform: scale(0.96);
        }

        .card-hover {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(10, 25, 47, 0.1), 0 8px 10px -6px rgba(10, 25, 47, 0.1);
        }

        /* Animasi Jungkat-Jungkit Keseimbangan Hak & Kewajiban */
        @keyframes balanceSeeSaw {
            0%, 100% { transform: rotate(-4deg); }
            50% { transform: rotate(4deg); }
        }
        .animate-balance {
            transform-origin: center center;
            animation: balanceSeeSaw 4s ease-in-out infinite;
        }

        /* Custom Scrollbar untuk Area Diskusi / Modal */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #E2E8F0;
            border-radius: 999px;
        }
        ::-webkit-scrollbar-thumb {
            background: #94A3B8;
            border-radius: 999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748B;
        }

        /* State terpilih untuk Misi 1 */
        .stmt-card.selected {
            border-color: #2563EB;
            background-color: #EFF6FF;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.25);
            transform: scale(1.02);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased">

    <!-- =====================================================================
         TOP NAVIGATION BAR & SCOREBOARD TOGGLE (Tampil saat masuk aplikasi)
    ====================================================================== -->
    <header id="top-navbar" class="hidden sticky top-0 z-40 bg-navy-900 text-white shadow-lg border-b border-navy-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-3">
            <!-- Kiri: Navigasi Beranda & Judul -->
            <div class="flex items-center gap-3">
                <button onclick="navigateTo('dashboard')" class="btn-touch bg-navy-800 hover:bg-navy-700 text-white px-4 py-2.5 rounded-xl font-semibold flex items-center gap-2 border border-slate-700 shadow-sm text-sm sm:text-base">
                    <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    <span class="hidden sm:inline">Dashboard</span>
                </button>
                <div>
                    <span class="text-xs uppercase tracking-wider text-gold-400 font-bold block">Pendidikan Pancasila • Kelas X</span>
                    <h1 class="font-display font-bold text-base sm:text-xl leading-tight">MISI WARGA NEGARA</h1>
                </div>
            </div>

            <!-- Tengah: Pemilih Kelompok Aktif (Memudahkan Otomatisasi Skor) -->
            <div class="hidden md:flex items-center bg-navy-800 px-3 py-1.5 rounded-2xl border border-slate-700 gap-2">
                <span class="text-xs text-slate-300 font-medium">Giliran Aktif:</span>
                <select id="active-team-select" onchange="changeActiveTeam(this.value)" class="bg-electric-500 text-white font-bold text-sm px-3 py-1.5 rounded-xl focus:outline-none cursor-pointer">
                    <option value="0">🦅 Kelompok Garuda</option>
                    <option value="1">🦅 Kelompok Rajawali</option>
                    <option value="2">🦅 Kelompok Elang</option>
                    <option value="3">🕊️ Kelompok Merpati</option>
                </select>
            </div>

            <!-- Kanan: Tombol Panel Papan Skor Kelompok & Suara -->
            <div class="flex items-center gap-2 sm:gap-3">
                <button onclick="toggleSound()" id="sound-btn" title="Efek Suara" class="btn-touch bg-navy-800 hover:bg-navy-700 p-2.5 rounded-xl border border-slate-700 text-gold-400">
                    <svg id="sound-on-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                    <svg id="sound-off-icon" class="w-6 h-6 hidden text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
                </button>

                <button onclick="toggleScoreboardModal()" class="btn-touch bg-gold-500 hover:bg-gold-400 text-navy-900 font-extrabold px-4 py-2.5 rounded-xl shadow-md flex items-center gap-2 text-sm sm:text-base">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    <span>Papan Skor</span>
                </button>
            </div>
        </div>
    </header>

    <!-- =====================================================================
         MAIN CONTENT AREA
    ====================================================================== -->
    <main class="flex-grow flex flex-col">

        <!-- =================================================================
             1. HALAMAN PEMBUKA (LANDING SCREEN)
        ================================================================== -->
        <section id="page-landing" class="page-section active flex-grow bg-gradient-to-br from-navy-900 via-navy-800 to-electric-500 text-white flex items-center justify-center p-4 sm:p-8 relative overflow-hidden">
            <!-- Dekorasi Latar Geometris Halus -->
            <div class="absolute top-0 left-0 w-96 h-96 bg-electric-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 right-0 w-96 h-96 bg-gold-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 translate-x-1/3 translate-y-1/3"></div>

            <div class="max-w-6xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
                <!-- Kolom Teks & Tombol -->
                <div class="lg:col-span-7 text-center lg:text-left space-y-6">
                    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 px-4 py-2 rounded-full text-gold-400 font-bold text-sm tracking-wide">
                        <span>🇮🇩 KURIKULUM MERDEKA • PENDIDIKAN PANCASILA KELAS X SMA</span>
                    </div>

                    <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl leading-tight tracking-tight">
                        MISI <span class="text-gold-400">WARGA NEGARA</span>
                    </h1>

                    <p class="text-xl sm:text-2xl font-semibold text-blue-100">
                        "Pahami Hakmu, Laksanakan Kewajibanmu!"
                    </p>

                    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                        Petualangan belajar kolaboratif dan gamifikasi interaktif untuk mengeksplorasi keseimbangan hak dan kewajiban sebagai warga sekolah maupun warga masyarakat.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
                        <button onclick="startAdventure()" class="btn-touch w-full sm:w-auto bg-gold-500 hover:bg-gold-400 text-navy-900 font-display font-extrabold text-lg sm:text-xl px-8 py-5 rounded-2xl shadow-xl shadow-gold-500/25 flex items-center justify-center gap-3">
                            <span>MULAI PETUALANGAN</span>
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                        </button>

                        <button onclick="toggleGuideModal()" class="btn-touch w-full sm:w-auto bg-white/10 hover:bg-white/20 backdrop-blur-md border-2 border-white/30 text-white font-bold text-lg px-7 py-5 rounded-2xl flex items-center justify-center gap-2">
                            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>PETUNJUK PERMAINAN</span>
                        </button>
                    </div>
                </div>

                <!-- Kolom Ilustrasi SVG Kustom: Siswa SMA, Sekolah & Masyarakat -->
                <div class="lg:col-span-5 flex justify-center">
                    <div class="bg-white/10 backdrop-blur-lg border border-white/20 p-6 rounded-3xl shadow-2xl w-full max-w-md">
                        <svg viewBox="0 0 400 320" class="w-full h-auto drop-shadow-lg" xmlns="http://www.w3.org/2000/svg">
                            <!-- Latar Langit & Matahari -->
                            <circle cx="320" cy="60" r="32" fill="#FBBF24" opacity="0.9"/>
                            <path d="M40 260 Q200 220 360 260 L360 290 L40 290 Z" fill="#1E3A8A"/>
                            
                            <!-- Gedung Sekolah (Kiri) -->
                            <rect x="35" y="130" width="120" height="120" rx="10" fill="#EFF6FF"/>
                            <polygon points="25,135 95,85 165,135" fill="#F59E0B"/>
                            <rect x="78" y="190" width="34" height="60" rx="4" fill="#1D3557"/>
                            <rect x="50" y="150" width="24" height="24" rx="4" fill="#3B82F6"/>
                            <rect x="116" y="150" width="24" height="24" rx="4" fill="#3B82F6"/>
