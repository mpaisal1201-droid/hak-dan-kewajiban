    <!-- =====================================================================
         JAVASCRIPT LOGIC & STATE MANAGEMENT
    ====================================================================== -->
    <script>
        // =================================================================
        // 1. STATE APLIKASI & AUDIO SYNTHESIZER (TONE.JS)
        // =================================================================
        const appState = {
            currentPage: 'landing',
            soundEnabled: true,
            activeTeamIndex: 0,
            teams: [
                { id: 0, name: 'Kelompok Garuda', icon: '🦅', score: 0, color: 'from-amber-500 to-orange-600' },
                { id: 1, name: 'Kelompok Rajawali', icon: '🦅', score: 0, color: 'from-blue-600 to-indigo-700' },
                { id: 2, name: 'Kelompok Elang', icon: '🦅', score: 0, color: 'from-emerald-500 to-teal-700' },
                { id: 3, name: 'Kelompok Merpati', icon: '🕊️', score: 0, color: 'from-sky-500 to-cyan-600' }
            ],
            completedZones: {
                materi: false,
                misi1: false,
                misi2: false,
                misi3: false,
                misi4: false,
                kuis: false
            },
            materiStep: 0,
            misi1SelectedCardId: null,
            misi1Placed: {}, // { cardId: 'HAK' | 'KEWAJIBAN' }
            misi2CurrentCase: 0,
            misi2Answered: {}, // { caseIdx: optionIdx }
            misi3CurrentCase: 0,
            misi3Answered: {}, // { caseIdx: { hak: bool, kewajiban: bool, solusi: bool } }
            quizCurrentIdx: 0,
            quizScore: 0,
            quizAnswered: {} // { qIdx: selectedOptionIdx }
        };

        // Efek suara sintetis ringan tanpa file eksternal
        function playTone(type) {
            if (!appState.soundEnabled || typeof Tone === 'undefined') return;
            try {
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                const synth = new Tone.Synth().toDestination();
                if (type === 'click') {
                    synth.triggerAttackRelease('C5', '32n');
                } else if (type === 'correct') {
                    synth.triggerAttackRelease('E5', '16n');
                    setTimeout(() => synth.triggerAttackRelease('G5', '16n'), 90);
                    setTimeout(() => synth.triggerAttackRelease('C6', '8n'), 180);
                } else if (type === 'wrong') {
                    synth.triggerAttackRelease('A3', '16n');
                    setTimeout(() => synth.triggerAttackRelease('F3', '8n'), 120);
                } else if (type === 'fanfare') {
                    synth.triggerAttackRelease('C5', '16n');
                    setTimeout(() => synth.triggerAttackRelease('E5', '16n'), 100);
                    setTimeout(() => synth.triggerAttackRelease('G5', '16n'), 200);
                    setTimeout(() => synth.triggerAttackRelease('C6', '4n'), 300);
                }
            } catch (e) {
                // Abaikan jika browser membatasi audio sebelum interaksi
            }
        }

        function toggleSound() {
            appState.soundEnabled = !appState.soundEnabled;
            document.getElementById('sound-on-icon').classList.toggle('hidden', !appState.soundEnabled);
            document.getElementById('sound-off-icon').classList.toggle('hidden', appState.soundEnabled);
        }

        function showToast(text, icon = '⭐') {
            const toast = document.getElementById('toast-notification');
            document.getElementById('toast-text').textContent = text;
            document.getElementById('toast-icon').textContent = icon;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 2600);
        }

        // =================================================================
        // 2. NAVIGASI HALAMAN & MODAL
        // =================================================================
        function startAdventure() {
            playTone('fanfare');
            navigateTo('dashboard');
        }

        function navigateTo(pageId) {
            playTone('click');
            appState.currentPage = pageId;

            // Sembunyikan semua section
            document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));
            const target = document.getElementById(`page-${pageId}`);
            if (target) target.classList.add('active');

            // Tampilkan/Sembunyikan Navbar Atas
            const navbar = document.getElementById('top-navbar');
            if (pageId === 'landing') {
                navbar.classList.add('hidden');
            } else {
                navbar.classList.remove('hidden');
            }

            // Render konten sesuai halaman tujuan
            if (pageId === 'dashboard') renderDashboard();
            if (pageId === 'materi') renderMateri();
            if (pageId === 'misi1') renderMisi1();
            if (pageId === 'misi2') renderMisi2();
            if (pageId === 'misi3') renderMisi3();
            if (pageId === 'kuis') renderQuiz();

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleGuideModal() {
            playTone('click');
            document.getElementById('modal-guide').classList.toggle('hidden');
        }

        function toggleScoreboardModal() {
            playTone('click');
            renderScoreboardModal();
            document.getElementById('modal-scoreboard').classList.toggle('hidden');
        }

        // =================================================================
        // 3. SISTEM KELOMPOK & PAPAN SKOR
        // =================================================================
        function changeActiveTeam(index) {
            appState.activeTeamIndex = parseInt(index, 10);
            document.getElementById('active-team-select').value = appState.activeTeamIndex;
            const quizSelect = document.getElementById('quiz-team-select');
            if (quizSelect) quizSelect.value = appState.activeTeamIndex;
            renderDashboardTeamPills();
        }

        function addTeamPoints(teamIndex, delta, reason = '') {
            const team = appState.teams[teamIndex];
            team.score = Math.max(0, team.score + delta);
            renderDashboardLeaderboard();
            renderScoreboardModal();
            if (delta > 0) {
                showToast(`+${delta} Poin untuk ${team.name}! ${reason}`, '🏆');
            }
        }

        function resetAllScores() {
            appState.teams.forEach(t => t.score = 0);
            renderDashboardLeaderboard();
            renderScoreboardModal();
            showToast('Semua skor kelompok telah di-reset ke 0', '🔄');
        }

        function renderDashboardTeamPills() {
            const container = document.getElementById('dashboard-team-pills');
            if (!container) return;
            container.innerHTML = appState.teams.map((team, idx) => {
                const isActive = idx === appState.activeTeamIndex;
                return `
                    <button onclick="changeActiveTeam(${idx})" class="btn-touch px-3 py-2 rounded-xl font-bold text-xs sm:text-sm transition-all ${
                        isActive
                            ? 'bg-electric-500 text-white shadow-md ring-2 ring-blue-300'
                            : 'bg-white text-slate-700 hover:bg-slate-200 border border-slate-200'
                    }">
                        ${team.icon} ${team.name.replace('Kelompok ', '')}
                    </button>
                `;
            }).join('');
        }

        function renderDashboardLeaderboard() {
            const container = document.getElementById('dashboard-leaderboard');
            if (!container) return;
            const sorted = [...appState.teams].sort((a, b) => b.score - a.score);
            container.innerHTML = sorted.map((team, rank) => {
                const medals = ['🥇', '🥈', '🥉', '🎖️'];
                return `
                    <div class="p-4 rounded-2xl border ${rank === 0 && team.score > 0 ? 'bg-amber-50 border-gold-400' : 'bg-slate-50 border-slate-200'} flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="text-2xl">${medals[rank]}</span>
                            <div>
                                <div class="font-bold text-navy-900 text-sm">${team.name}</div>
                                <div class="text-xs text-slate-500">Peringkat #${rank + 1}</div>
                            </div>
                        </div>
                        <div class="font-display font-extrabold text-xl text-electric-500">${team.score} <span class="text-xs font-normal text-slate-500">pts</span></div>
                    </div>
                `;
            }).join('');
        }

        function renderScoreboardModal() {
            const container = document.getElementById('modal-teams-list');
            if (!container) return;
            // Urutkan tampilan berdasarkan skor tertinggi untuk efek live leaderboard
            const sorted = [...appState.teams].sort((a, b) => b.score - a.score);
            container.innerHTML = sorted.map((team, rank) => `
                <div class="p-5 rounded-2xl border-2 ${rank === 0 && team.score > 0 ? 'border-gold-400 bg-amber-50/40' : 'border-slate-200 bg-white'} flex flex-col justify-between gap-4 shadow-sm">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="w-10 h-10 rounded-xl bg-navy-900 text-gold-400 font-display font-extrabold flex items-center justify-center">#${rank + 1}</span>
                            <div>
                                <h4 class="font-display font-bold text-lg text-navy-900">${team.icon} ${team.name}</h4>
                                <span class="text-xs text-slate-500">Total Perolehan Poin</span>
                            </div>
                        </div>
                        <div class="font-display font-extrabold text-3xl text-electric-500">${team.score}</div>
                    </div>
                    <div class="grid grid-cols-4 gap-2 pt-2 border-t border-slate-100">
                        <button onclick="addTeamPoints(${team.id}, -10)" class="btn-touch bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold py-2.5 rounded-xl text-sm">-10</button>
                        <button onclick="addTeamPoints(${team.id}, 10, '(Jawaban/Partisipasi)')" class="btn-touch bg-blue-100 hover:bg-blue-200 text-electric-500 font-bold py-2.5 rounded-xl text-sm">+10</button>
                        <button onclick="addTeamPoints(${team.id}, 20, '(Analisis Kasus)')" class="btn-touch bg-emerald-100 hover:bg-emerald-200 text-emerald-700 font-bold py-2.5 rounded-xl text-sm">+20</button>
                        <button onclick="changeActiveTeam(${team.id}); toggleScoreboardModal();" class="btn-touch bg-navy-900 text-white font-bold py-2.5 rounded-xl text-xs">Pilih Aktif</button>
                    </div>
                </div>
            `).join('');
        }

        function renderDashboard() {
            renderDashboardTeamPills();
            renderDashboardLeaderboard();

            // Update badge status selesai
            const keys = Object.keys(appState.completedZones);
            const doneCount = keys.filter(k => appState.completedZones[k]).length;
            document.getElementById('progress-badge').textContent = `${doneCount} / 6 Zona Selesai`;

            keys.forEach(k => {
                const el = document.getElementById(`status-${k}`);
                if (el && appState.completedZones[k]) {
                    el.textContent = '✓ Selesai';
                    el.className = 'text-xs font-bold px-3 py-1 rounded-full bg-emerald-100 text-emerald-700';
                }
            });
        }

        // =================================================================
        // 4. DATA & LOGIKA ZONA MATERI (5 BAGIAN)
        // =================================================================
        const materiData = [
            {
                title: 'Materi 1: Pengertian Hak',
                badge: 'Konsep Dasar 1',
                icon: '🎁',
                definition: 'Hak merupakan sesuatu yang pantas diterima, dimiliki, atau diperoleh seseorang sesuai dengan ketentuan dan norma yang berlaku.',
                points: [
                    'Hak melekat pada setiap manusia sejak lahir (Hak Asasi) maupun diperoleh karena kedudukannya (sebagai siswa atau warga negara).',
                    'Pemenuhan hak seseorang dibatasi oleh hak orang lain serta aturan hukum yang berlaku.',
                    'Contoh sederhana: Siswa berhak memperoleh ilmu pengetahuan dan perlindungan di sekolah.'
                ],
                visualType: 'hak'
            },
            {
                title: 'Materi 2: Pengertian Kewajiban',
                badge: 'Konsep Dasar 2',
                icon: '🛡️',
